# ============================================================
# ResQNet — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ---- Application ----
APP_NAME=ResQNet
APP_ENV=development          # development | production
DEBUG=true
SECRET_KEY=change-me-to-a-random-64-char-string
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ---- CockroachDB ----
# Get this from CockroachDB Cloud Console → Connect → Connection string
# Format: postgresql+asyncpg://user:password@host:26257/defaultdb?sslmode=verify-full
DATABASE_URL=postgresql+asyncpg://root@localhost:26257/resqnet
COCKROACH_MCP_DATABASE_URL=postgresql://root@localhost:26257/resqnet

# ---- AI Provider ----
# Options: bedrock | gemini
AI_PROVIDER=gemini

# Amazon Bedrock (set AI_PROVIDER=bedrock and fill these)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_CHAT_MODEL=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0

# Google Gemini (set AI_PROVIDER=gemini and fill this)
# Get free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# Embedding dimension (must match model output: 1536 for Titan v2, 768 for Gemini)
EMBEDDING_DIM=768

# ---- AWS S3 (Evidence Storage) ----
# Set USE_S3_MOCK=true to use local filesystem instead of real S3
USE_S3_MOCK=true
S3_BUCKET_NAME=resqnet-evidence
S3_REGION=us-east-1
# AWS credentials reused from above if AI_PROVIDER=bedrock
# Local mock uploads directory (used when USE_S3_MOCK=true)
LOCAL_UPLOAD_DIR=./uploads

# ---- AWS Lambda ----
# Set USE_LAMBDA_MOCK=true to process inline instead of invoking Lambda
USE_LAMBDA_MOCK=true
LAMBDA_FUNCTION_NAME=resqnet-report-analyzer
LAMBDA_REGION=us-east-1

# ---- Auth ----
# JWT settings — change SECRET_KEY above
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080    # 7 days for demo

# ---- Backend ----
BACKEND_PORT=8000

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=ResQNet
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png
NEXT_PUBLIC_ENABLE_MOCK_SMS=true
